rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- who is who ----------
    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.email.lower(); }
    function staffDoc() { return get(/databases/$(database)/documents/settings/staff).data; }
    function isStaff() {
      return signedIn() && exists(/databases/$(database)/documents/settings/staff) && email() in staffDoc().emails;
    }
    function isOwner() { return isStaff() && email() == staffDoc().ownerEmail; }
    function role() { return isOwner() ? 'owner' : staffDoc().roles.get(email(), 'none'); }
    function isManager() { return isStaff() && role() == 'manager'; }          // event center manager
    function myOutlet() { return staffDoc().get('outlets', {}).get(email(), ''); }
    function isCashier() { return isStaff() && role() == 'cashier' && myOutlet() != ''; }
    function centre() { return isOwner() || isManager(); }

    // ---------- data checks ----------
    function validMoney() {
      return !(request.resource.data.keys().hasAny(['amount'])) || (request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount < 100000000);
    }
    function validSale() {
      return request.resource.data.total is number && request.resource.data.total >= 0
        && request.resource.data.status in ['open', 'paid', 'void']
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 100;
    }
    // A cashier's normal sale must be dated today, or at most 3 days back (a till that was offline keeps the sale's own
    // day and only reaches the server later). The server clock is UTC, which is Ghana time all year.
    // To allow longer offline spells, add more days to the list in dayOk(). Applies to `date` and `paidDate` (reports use paidDate first).
    function dayNum(t) { return t.year() * 10000 + t.month() * 100 + t.day(); }
    function dayOk(d) {
      return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && int(d.replace('-', '')) in [dayNum(request.time + duration.value(1, 'd')), dayNum(request.time), dayNum(request.time - duration.value(1, 'd')), dayNum(request.time - duration.value(2, 'd')), dayNum(request.time - duration.value(3, 'd'))];
    }
    function saleDatesOk() { return dayOk(request.resource.data.date) && dayOk(request.resource.data.get('paidDate', request.resource.data.date)); }
    function isLegacy() { return request.resource.data.keys().hasAny(['legacy']); }     // marks an old paper record; only the oldSales function (and the owner restoring a backup) may write one
    function onlyKeys(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // ---------- access list: the first person to sign in becomes the owner ----------
    match /settings/staff {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerEmail == email() && request.resource.data.emails == [email()];
      allow update: if isOwner() && request.resource.data.ownerEmail == resource.data.ownerEmail;
      allow delete: if false;
    }
    match /settings/{doc} {
      allow read: if isStaff();
      allow write: if isOwner();
    }
    match /audit/{doc} {
      allow create: if isStaff() && request.resource.data.by == email();
      allow read: if isOwner();
      allow update, delete: if false;
    }

    // ---------- owner only: the money behind the business ----------
    match /expenses/{doc}          { allow read, write: if isOwner(); }
    match /expenseCategories/{doc} { allow read, write: if isOwner(); }
    match /vendors/{doc}           { allow read, write: if isOwner(); }
    match /stockMoves/{doc}        { allow read, write: if isOwner(); }
    match /stockCosts/{doc}        { allow read, write: if isOwner(); }     // cost per unit, never visible to a till
    match /crewPay/{doc}           { allow read, write: if isOwner(); }     // what each crew member is paid, keyed by booking id
    match /outlets/{doc} {
      allow read: if isStaff();
      allow write: if isOwner();
    }

    // ---------- the three bars: a cashier only ever touches their own outlet ----------
    match /products/{doc} {
      allow read: if isOwner() || (isCashier() && resource.data.outletId == myOutlet());
      allow write: if isOwner();
    }
    match /stock/{doc} {
      allow read: if isOwner() || (isCashier() && resource.data.outletId == myOutlet());
      allow create, delete: if isOwner();
      allow update: if isOwner() || (isCashier() && resource.data.outletId == myOutlet() && onlyKeys(['qty', 'updatedAt', 'updatedBy']) && request.resource.data.qty is number && request.resource.data.qty >= 0);   // a till can never sell below zero
    }
    match /sales/{doc} {
      allow read: if isOwner() || (isCashier() && resource.data.outletId == myOutlet());
      allow create: if (isOwner() && validSale())
        || (isCashier() && validSale() && request.resource.data.outletId == myOutlet() && request.resource.data.staff == email() && request.resource.data.status == 'paid' && !isLegacy() && saleDatesOk());   // old paper sales are only ever written by the oldSales function; a normal sale cannot be back-dated
      allow update: if isOwner() && validSale();   // only the owner can void or correct a sale
      allow delete: if isOwner();
    }
    match /shifts/{doc} {
      allow read: if isOwner() || (isCashier() && resource.data.outletId == myOutlet());
      allow create: if isOwner() || (isCashier() && request.resource.data.staff == email() && request.resource.data.outletId == myOutlet());
      // a cashier may only close their own still-open shift, and only the close-out fields: a closed (counted) till can never be edited again
      allow update: if isOwner() || (isCashier() && resource.data.staff == email() && resource.data.outletId == myOutlet() && resource.data.closedAt == 0
        && onlyKeys(['closedAt', 'counted', 'expected', 'diff', 'note', 'totals', 'updatedAt', 'updatedBy']));
      allow delete: if isOwner();
    }

    // ---------- the event center: manager and owner; prices and deletions stay with the owner ----------
    match /bookings/{doc} {
      allow read: if centre();
      allow create: if centre() && validMoney() && (isOwner() || !request.resource.data.keys().hasAny(['price', 'priceAuto', 'priceOverride', 'pricedAt']));
      allow update: if centre() && validMoney() && (isOwner() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['price', 'priceAuto', 'priceOverride', 'pricedAt']));
      allow delete: if isOwner();
    }
    match /clients/{doc} {
      allow read: if centre();
      allow create, update: if centre();
      allow delete: if isOwner();
    }
    match /stays/{doc} {
      allow read: if centre();
      allow create: if centre() && validMoney() && (isOwner() || !request.resource.data.keys().hasAny(['rate', 'nightly', 'rateOverride', 'discount', 'pricedAt']));
      allow update: if centre() && validMoney() && (isOwner() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rate', 'nightly', 'rateOverride', 'discount', 'pricedAt']));
      allow delete: if isOwner();
    }
    match /payments/{doc} {
      allow read: if centre();
      allow create, update: if centre() && validMoney() && (isOwner() || !isLegacy());   // managers cannot add or change old paper records directly
      allow delete: if isOwner();
    }
    match /spaces/{doc} {            // the price list for halls and areas
      allow read: if centre();
      allow write: if isOwner();
    }
    match /rooms/{doc} {             // room rates (rateWeekday, rateWeekend); the manager may only change housekeeping status
      allow read: if centre();
      allow create, delete: if isOwner();
      allow update: if isOwner() || (isManager() && onlyKeys(['status', 'updatedAt', 'updatedBy']));
    }
  }
}
